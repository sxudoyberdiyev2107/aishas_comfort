# Express API Server Port
PORT=5000

# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=aishas_comfort
DB_PASSWORD=postgres
DB_PORT=5432

# JWT Secret Hashing Key (for admin sessions)
# MAJBURIY: bu o'zgaruvchisiz server ishga tushmaydi.
# Uzun tasodifiy qiymat yarating (kamida 32 belgi):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_long_random_value_here

# Admin hisobi (faqat create-admin.js skripti uchun ishlatiladi)
# Parolni HECH QACHON kodga yozmang — faqat shu yerda / Railway Variables'da.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password_here

# Telegram Bot Configurations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
